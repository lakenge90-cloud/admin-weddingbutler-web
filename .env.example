DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Solapi (https://solapi.com) — direct KakaoTalk 알림톡 sending. If any of these
# are unset, sends are skipped with a console warning (never breaks the caller).
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER_PHONE=""          # Solapi에 등록된 발신번호
SOLAPI_PF_ID=""                 # 연동한 카카오 비즈니스 채널 pfId
SOLAPI_TEMPLATE_NEW_CUSTOMER=""  # "예약 신청 완료" 템플릿 ID
SOLAPI_TEMPLATE_NEW_STAFF=""     # "신규 예약 신청" 템플릿 ID
SOLAPI_TEMPLATE_CONFIRMED=""     # "예약 확정" 템플릿 ID
SOLAPI_TEMPLATE_REMIND_7D=""     # "예식 7일 전 안내" 템플릿 ID (KA01TP261014052441644aJO9b9CkFXU)
SOLAPI_TEMPLATE_REMIND_DAY=""    # "예식 당일 안내" 템플릿 ID (KA01TP261014052022243XmzEXF8k7uY)
SOLAPI_STAFF_PHONES=""          # 운영팀 번호, 콤마로 구분 (예: 01011112222,01033334444)

# KakaoWork bot — 신규 예약 신청 시 운영팀 대화방으로 알림. 둘 다 unset이면
# 조용히 skip (never breaks the caller).
KAKAOWORK_APP_KEY=""            # 카카오워크 봇 App Key
KAKAOWORK_CONVERSATION_ID=""    # 봇이 conversations.open으로 만든 운영팀 그룹 대화방 ID

# Required for the public reservation-intake API (POST /api/public/reservations).
# The homepage's backend must send this as `Authorization: Bearer <value>`.
# Requests without a matching key are rejected with 401; if this is unset, the
# endpoint refuses every request with 500 rather than accepting unauthenticated data.
RESERVATION_API_KEY=""

# 고객 축의 기록 (홈페이지 /r/[token]) — 홈페이지 서버가 /api/public/records/* 를 부를 때 쓰는 키.
# 비워 두면 RESERVATION_API_KEY를 그대로 쓴다 (홈페이지의 ADMIN_API_KEY와 같은 값).
RECORD_API_KEY=""
# 고객용 링크를 만들 홈페이지 주소. 비워 두면 https://weddingbutler.co.kr
HOMEPAGE_URL=""
# 고객 축의 기록 링크 도메인 (비우면 https://report.weddingbutler.co.kr)
REPORT_URL=""

# Vercel Cron(vercel.json)이 /api/cron/reminders 를 부를 때 쓰는 키. Vercel이 자동으로
# Authorization: Bearer <CRON_SECRET> 을 붙인다. 비워 두면 리마인더 알림톡이 나가지 않는다.
CRON_SECRET=""
